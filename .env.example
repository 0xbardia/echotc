# Optional. The desk defaults to the deployed Studionet contract (0xCABcFaBC7a76d602b8c4b0Aed367853155aDe59B).
# Set this only to target an alternate deployment.
VITE_ECHO_CONTRACT_ADDRESS=

# Optional. Injected wallets (MetaMask, Rabby, etc.) work without this.
# Provide a valid Reown / WalletConnect Project ID to enable WalletConnect QR modals.
VITE_WALLETCONNECT_PROJECT_ID=
