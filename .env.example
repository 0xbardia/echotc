# Explicit configuration required. Leave unset or empty for local-only/Direct Mode.
# Set to your deployed contract address (0x...) from GenLayer Studio to enable on-chain reads and writes.
VITE_ECHO_CONTRACT_ADDRESS=

# Optional. Injected wallets (MetaMask, Rabby, etc.) work without this.
# Provide a valid Reown / WalletConnect Project ID to enable WalletConnect QR modals.
VITE_WALLETCONNECT_PROJECT_ID=
